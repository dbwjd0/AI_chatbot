# OpenAI API Key - https://platform.openai.com/api-keys 에서 발급받아 입력하세요.
OPENAI_API_KEY="Your_OpenAI_API_Key_Here"

# Django Secret Key - https://djecrety.ir/ 에서 새로운 키를 발급받아 입력하세요.
SECRET_KEY="Your_Django_Secret_Key_Here"

# (Optional) Fine-tuned Model ID - 파인튜닝된 모델을 사용하려면 모델 ID를 입력하세요.
FINETUNED_MODEL_ID="Your_FineTuned_Model_ID_Here"

# Kakao Maps API Key - https://developers.kakao.com/ 에서 발급받은 REST API 키를 입력하세요.
KAKAO_API_KEY="Your_Kakao_REST_API_Key_Here"