msgstr "ごめん、今は応答できないよ。(サーバーエラー)"

#: .\chatbot_app\static\chat.js:402
msgid "No learning data to send feedback for."
msgstr "フィードバックを送信するための学習データがありません。"

#: .\chatbot_app\static\chat.js:425
