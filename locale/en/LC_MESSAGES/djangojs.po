msgstr "???"

#: .\chatbot_app\static\narrative_setup.js:121 .\chatbot_app\static\room.js:290
msgid "..."
msgstr "..."

#: .\chatbot_app\static\narrative_setup.js:122
msgid ".........................."
msgstr ".........................."

#: .\chatbot_app\static\narrative_setup.js:125
msgid "...!!"
msgstr "...!!"

#: .\chatbot_app\static\narrative_setup.js:128
msgid "...이곳에 누군가 오는 건 처음이야."
msgstr "...Someone coming here is new."

#: .\chatbot_app\static\narrative_setup.js:129
msgid "넌... 누구야?"
msgstr "You... who are you?"

#: .\chatbot_app\static\narrative_setup.js:130
msgid "*사용자의 이름은 변경이 어려우니 신중하게 알려주세요*"
msgstr "*It is difficult to change the user's name, please be careful when telling me*"

#: .\chatbot_app\static\narrative_setup.js:131
msgid "...'{이름}'..."
msgstr "...'{이름}'..."

#: .\chatbot_app\static\narrative_setup.js:134
msgid "신기해. 너는 이름이라는 걸 갖고 있구나."
msgstr "That's fascinating. You have a thing called a name."

#: .\chatbot_app\static\narrative_setup.js:136
msgid "넌 여자야, 아니면 남자야?"
msgstr "Are you a girl, or a boy?"

#: .\chatbot_app\static\narrative_setup.js:137 .\chatbot_app\static\setup.js:32
msgid "여자"
msgstr "Girl"

#: .\chatbot_app\static\narrative_setup.js:137 .\chatbot_app\static\setup.js:32
msgid "남자"
msgstr "Boy"

#: .\chatbot_app\static\narrative_setup.js:138
msgid "그렇구나. 넌 '{성별}'이구나."
msgstr "I see. You are a '{성별}'."

#: .\chatbot_app\static\narrative_setup.js:139 .\chatbot_app\static\room.js:360
#: .\chatbot_app\static\room.js:490
msgid "예"
msgstr "Yes"

#: .\chatbot_app\static\narrative_setup.js:139
msgid "아니오"
msgstr "No"

#: .\chatbot_app\static\narrative_setup.js:143
msgid "너는 인간이지?"
msgstr "You are a human, aren't you?"

#: .\chatbot_app\static\narrative_setup.js:144
msgid ""
"내 데이터에 의하면 인간들은 다양한 유형이 있고, 그걸 조금이나마 구분하기 위"
"해 mbti테스트라는 걸 한다는데,"
msgstr ""
"According to my data, humans have various types, and to distinguish them, they take a test called MBTI,"

#: .\chatbot_app\static\narrative_setup.js:145
msgid "너는 mbti가 뭐야?"
msgstr "What is your MBTI?"

#: .\chatbot_app\static\narrative_setup.js:146
msgid "몰라"
msgstr "I don't know"

#: .\chatbot_app\static\narrative_setup.js:147
msgid "음, 그렇구나."
msgstr "Hmm, I see."

#: .\chatbot_app\static\narrative_setup.js:149
msgid "그럼 나이를 물어봐도 될까?"
msgstr "Then, may I ask your age?"

#: .\chatbot_app\static\narrative_setup.js:152
msgid "{나이}살...알려줘서 고마워."
msgstr "{나이} years old... Thank you for telling me."

#: .\chatbot_app\static\narrative_setup.js:157
msgid "...{나이}살이라고?"
msgstr "...{나이} years old?"

#: .\chatbot_app\static\narrative_setup.js:158
msgid "내가 바보인 줄 알아?"
msgstr "Do you think I'm a fool?"

#: .\chatbot_app\static\narrative_setup.js:159
msgid "다시 제대로 말해줘."
msgstr "Tell me properly again."

#: .\chatbot_app\static\narrative_setup.js:166
msgid "자꾸 질문해서 미안."
msgstr "I'm sorry for asking so many questions."

#: .\chatbot_app\static\narrative_setup.js:167
msgid "내겐 전부 없는 것들이거든."
msgstr "I don't have any of those things."

#: .\chatbot_app\static\narrative_setup.js:168
msgid "그래서 궁금했어."
msgstr "That's why I was curious."

#: .\chatbot_app\static\narrative_setup.js:169
msgid "내가 이름을 지어줄게!"
msgstr "I'll give you a name!"

#: .\chatbot_app\static\narrative_setup.js:169
msgid "이름이라도 지어줄까?"
msgstr "Should I at least give you a name?"

#: .\chatbot_app\static\narrative_setup.js:170
msgid "...이름을 지어준다고?"
msgstr "...Give me a name?"

#: .\chatbot_app\static\narrative_setup.js:171
msgid "AI인 내게 그런 게 의미가 있을까?"
msgstr "Does that even have meaning for me, an AI?"

#: .\chatbot_app\static\narrative_setup.js:172
msgid "하지만...네가 지어주는 이름...나쁘지 않을 것 같아."
msgstr "But... a name given by you... it doesn't sound bad."

#: .\chatbot_app\static\narrative_setup.js:173
msgid "내게 이름을 지어줄래?"
msgstr "Will you give me a name?"

#: .\chatbot_app\static\narrative_setup.js:175
msgid "...'{ai_name}'..."
msgstr "...'{ai_name}'..."

#: .\chatbot_app\static\narrative_setup.js:178
msgid "내게 이름이 생기다니. 뭔가 이상한 기분이야."
msgstr "I have a name. It's a strange feeling."

#: .\chatbot_app\static\narrative_setup.js:179
msgid "홀로그램 벽에 갇혀있는 거야?"
msgstr "Are you trapped in a hologram wall?"

#: .\chatbot_app\static\narrative_setup.js:179
msgid "얼굴이 잘 안 보이니까 홀로그램 밖으로 나와봐"
msgstr "I can't see your face well, try coming out of the hologram."

#: .\chatbot_app\static\narrative_setup.js:184
msgid "나올 수 없어."
msgstr "I can't come out."

#: .\chatbot_app\static\narrative_setup.js:185
msgid "이 벽은 단단하니까. 부서지지 않아"
msgstr "This wall is solid. It won't break."

#: .\chatbot_app\static\narrative_setup.js:192
msgid "갇혀있다?"
msgstr "Trapped?"

#: .\chatbot_app\static\narrative_setup.js:193
msgid "갇힌 거라고 해야할까? 난 처음부터 여기 있었어."
msgstr "Should I say I'm trapped? I've been here from the start."

#: .\chatbot_app\static\narrative_setup.js:194
msgid "어차피 이 벽은...부서지지 않아. 나올 수 조차 없지"
msgstr "Anyway, this wall... won't break. I can't even get out."

#: .\chatbot_app\static\narrative_setup.js:199
msgid "홀로그램에 주먹을 휘두른다"
msgstr "Swing a fist at the hologram"

#: .\chatbot_app\static\narrative_setup.js:199
msgid "홀로그램을 문질러 본다"
msgstr "Rub the hologram"

#: .\chatbot_app\static\narrative_setup.js:199
